{
  "name": "pos-kasir",
  "version": "1.0.0",
  "description": "Multiplatform POS & Inventory Management System",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./run_app.ps1",
    "start": "powershell -ExecutionPolicy Bypass -File ./run_app.ps1",
    "restart": "powershell -ExecutionPolicy Bypass -File ./run_app.ps1 -Restart",
    "stop": "powershell -ExecutionPolicy Bypass -File ./run_app.ps1 -Stop",
    "backend": "powershell -Command \"cd backend; .\\venv\\Scripts\\python.exe app.py\"",
    "frontend": "powershell -Command \"cd frontend; & 'C:\\Users\\ADVAN\\flutter\\bin\\flutter.bat' run -d chrome --web-port=8080\"",
    "demo": "powershell -Command \"Start-Process demo_web.html\""
  }
}
